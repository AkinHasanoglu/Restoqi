{
  "name": "@stockalert/database",
  "version": "0.0.1",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./server": "./src/server.ts",
    "./middleware": "./src/middleware.ts",
    "./types": "./src/types/database.types.ts",
    "./crypto": "./src/crypto.ts",
    "./stores": "./src/stores.ts",
    "./audit": "./src/audit.ts",
    "./api-keys": "./src/api-keys.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "gen:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID --schema public > src/types/database.types.ts",
    "gen:types:local": "supabase gen types typescript --local --schema public > src/types/database.types.ts",
    "migrate": "supabase db push",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:lint": "supabase db lint",
    "rotate-credentials": "tsx scripts/rotate-credentials.ts"
  },
  "dependencies": {
    "@stockalert/integrations-core": "workspace:*",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "next": ">=14.0.0 <16"
  },
  "devDependencies": {
    "@stockalert/config": "workspace:*",
    "@types/node": "^22.9.1",
    "next": "catalog:",
    "supabase": "^1.224.3",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "^2.1.6",
    "@vitest/coverage-v8": "^2.1.6"
  }
}
