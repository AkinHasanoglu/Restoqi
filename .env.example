# ============================================================
# STOCKALERT SAAS — Ortam Değişkenleri
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# Tüm credentials Faz 16'da bağlanacak.
# ============================================================

# --- Supabase (Cloud) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# Mağaza kimlik bilgileri için AES-256-GCM anahtarı (uygulama tarafında
# şifrelenir, DB'ye hiç girmez). Üret: openssl rand -base64 32
SUPABASE_ENCRYPTION_KEY=
# Anahtar rotasyonu sırasında eski anahtar(lar) — sadece decrypt için,
# virgülle ayrılmış liste. Rotasyon tamamlanınca kaldırın.
SUPABASE_ENCRYPTION_KEY_PREVIOUS=

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_LANDING_URL=http://localhost:3000
# /contact sayfasında gösterilir; boşsa mailto linki gizlenir.
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Legal / Compliance ---
# CAN-SPAM'ın gerektirdiği fiziksel iş adresi — her giden e-postanın
# alt bilgisinde gösterilir (packages/emails/src/components/email-footer.tsx).
NEXT_PUBLIC_COMPANY_ADDRESS=
# security.txt (RFC 9116) ve ihlal bildirimleri için güvenlik iletişim adresi.
NEXT_PUBLIC_SECURITY_CONTACT_EMAIL=

# --- Paddle Billing (Abonelik) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# sandbox | production
NEXT_PUBLIC_PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_PRICE_ID_STARTER_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_STARTER_ANNUAL=
NEXT_PUBLIC_PADDLE_PRICE_ID_GROWTH_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_GROWTH_ANNUAL=
NEXT_PUBLIC_PADDLE_PRICE_ID_SCALE_MONTHLY=
NEXT_PUBLIC_PADDLE_PRICE_ID_SCALE_ANNUAL=

# --- Resend (Email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- Upstash Redis + QStash ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Sentry ---
SENTRY_DSN_LANDING=
SENTRY_DSN_DASHBOARD=
NEXT_PUBLIC_SENTRY_DSN_LANDING=
NEXT_PUBLIC_SENTRY_DSN_DASHBOARD=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_LANDING=
SENTRY_PROJECT_DASHBOARD=

# --- PostHog ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- AI Providers (opsiyonel — kullanıcı kendi key'ini de girebilir) ---
# Anthropic
ANTHROPIC_API_KEY=
# OpenAI
OPENAI_API_KEY=

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated E.164 calling codes SMS is allowed to be sent to (toll-fraud
# guard — packages/notifications/src/channels/sms.ts). Defaults to "90" (Turkey).
SMS_ALLOWED_COUNTRY_CODES=90

# --- Marketplace: Shopify ---
# App-level OAuth client. SHOPIFY_CLIENT_SECRET also signs inbound webhooks
# (X-Shopify-Hmac-Sha256) — there is no separate webhook secret.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- Marketplace: Trendyol ---
# Per-store API key/secret/supplierId are entered via the connect form and
# stored encrypted (store_secrets.encrypted_creds) — no app-level env
# needed for those. Trendyol doesn't sign webhooks; verification falls back
# to the per-store webhook_secret (HTTP Basic) plus an optional IP allowlist.
# Comma-separated list of IPs Trendyol sends webhooks from.
TRENDYOL_WEBHOOK_IPS=

# --- Marketplace: Amazon (SP-API / LWA) ---
AMAZON_APP_ID=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REDIRECT_URI=
# Defaults to Amazon.co.uk (A1F83G8C2ARO7P) if unset.
AMAZON_MARKETPLACE_ID=

# --- Marketplace: Etsy (API v3) ---
# PKCE OAuth — no client secret. No push webhooks exist for this platform
# (poll-only). shop_id is resolved automatically during connect() via
# GET /application/users/me — no env var needed.
ETSY_CLIENT_ID=
ETSY_REDIRECT_URI=

# --- Marketplace: eBay ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REDIRECT_URI=
# Required for the GET webhook challenge handshake (Marketplace Account
# Deletion notifications) — eBay will not activate webhook delivery
# without a correct challenge response.
EBAY_VERIFICATION_TOKEN=
# true = api.sandbox.ebay.com, unset/false = api.ebay.com
EBAY_SANDBOX=

# --- Marketplace: Hepsiburada ---
# Per-store API key/merchantId are entered via the connect form and stored
# encrypted — no app-level env needed. No push webhooks exist (poll-only).

# --- Marketplace: AliExpress (Open Platform) ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# --- Sync worker ---
# Shared secret accepted as an internal fallback bearer token (in addition
# to CRON_SECRET and QStash signature verification) by /api/worker/sync.
WORKER_SECRET=
# Override if the worker route isn't reachable at NEXT_PUBLIC_APP_URL
# (e.g. a separate deployment). Defaults to `${NEXT_PUBLIC_APP_URL}/api/worker/sync`.
WORKER_URL=

# --- Cron (Vercel) ---
# Vercel injects `Authorization: Bearer $CRON_SECRET` automatically on
# Cron-triggered requests once this is set.
CRON_SECRET=

# ============================================================
# MONITORING HUB — raporlama (Hub bu reponun dışında, ayrı bir uygulama)
# ============================================================
HUB_URL=
HUB_WEBHOOK_SECRET=
HUB_API_KEY=
# Hub'daki Uygulama.name ile birebir aynı olmalı: stockalert-dashboard | stockalert-landing
APP_NAME=
# Hub'da bu app+name için kayıtlı Environment ile birebir aynı olmalı: production | local
HUB_ENVIRONMENT=production
