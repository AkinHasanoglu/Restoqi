# ============================================================
# STOCKALERT SAAS — Ortam Değişkenleri
# Bu dosyayı .env.local olarak kopyalayın ve değerleri doldurun.
# Tüm credentials Faz 16'da bağlanacak.
# ============================================================

# --- Supabase (Cloud) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
# pgcrypto şifreleme anahtarı (rastgele 32+ karakter)
SUPABASE_ENCRYPTION_KEY=

# --- App URLs ---
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_LANDING_URL=http://localhost:3000

# --- LemonSqueezy (Abonelik) ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL_STARTER=
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL_BUSINESS=
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL_ENTERPRISE=

# --- Resend (Email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- Upstash Redis + QStash ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# --- Sentry ---
SENTRY_DSN_LANDING=
SENTRY_DSN_DASHBOARD=
NEXT_PUBLIC_SENTRY_DSN_LANDING=
NEXT_PUBLIC_SENTRY_DSN_DASHBOARD=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT_LANDING=
SENTRY_PROJECT_DASHBOARD=

# --- PostHog ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# --- Cloudflare Turnstile ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- AI Providers (opsiyonel — kullanıcı kendi key'ini de girebilir) ---
# Anthropic
ANTHROPIC_API_KEY=
# OpenAI
OPENAI_API_KEY=

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- n8n Otomasyon ---
N8N_WEBHOOK_BASE_URL=
N8N_API_KEY=

# --- Marketplace: Shopify ---
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# --- Marketplace: Trendyol ---
# (Her mağaza için store_credentials tablosunda şifreli saklanır)
# Bu değişkenler Trendyol developer portal bilgileridir
TRENDYOL_APP_KEY=
TRENDYOL_APP_SECRET=

# --- Marketplace: Amazon ---
AMAZON_SP_APP_CLIENT_ID=
AMAZON_SP_APP_CLIENT_SECRET=
AMAZON_AWS_ACCESS_KEY=
AMAZON_AWS_SECRET_KEY=
AMAZON_AWS_REGION=eu-west-1

# --- Marketplace: Etsy ---
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=

# --- Marketplace: eBay ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=

# --- Marketplace: Hepsiburada ---
HEPSIBURADA_USERNAME=
HEPSIBURADA_PASSWORD=

# --- Marketplace: AliExpress ---
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=

# --- Cron (Vercel) ---
CRON_SECRET=
